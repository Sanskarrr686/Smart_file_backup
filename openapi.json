{"openapi":"3.0.3","info":{"title":"Smart File Backup System API","version":"1.0.0","description":"Team C APIs. Every application route requires a Team D service bearer token and a Team C identity assertion, except service-only identity lookup, health root, OpenAPI JSON, and Swagger UI."},"servers":[{"url":"http://localhost:3000","description":"Local development server"}],"tags":[{"name":"Health"},{"name":"Files"},{"name":"Backups"},{"name":"Reports"},{"name":"Auth & Users","description":"Login verification and user management for Team D"}],"components":{"securitySchemes":{"TeamDServiceBearer":{"type":"http","scheme":"bearer","bearerFormat":"opaque","description":"Shared server-side Team D to Team C service secret. Never expose to browsers."},"TeamCUserId":{"type":"apiKey","in":"header","name":"X-TeamC-User-Id","description":"Explicitly mapped Team C users.user_id, asserted only by Team D backend."},"TeamCRole":{"type":"apiKey","in":"header","name":"X-TeamC-Role","description":"Team C role asserted by Team D and checked against Team C database."}}},"security":[{"TeamDServiceBearer":[],"TeamCUserId":[],"TeamCRole":[]}],"paths":{"/":{"get":{"summary":"Public service health","security":[],"responses":{"200":{"description":"Service is running"}}}},"/openapi.json":{"get":{"summary":"Public OpenAPI document","security":[],"responses":{"200":{"description":"OpenAPI JSON"}}}},"/test-db":{"get":{"tags":["Health"],"summary":"Check MySQL connectivity","responses":{"200":{"description":"Database query succeeded."},"500":{"description":"Database query failed."}}}},"/api/v1/files":{"get":{"tags":["Files"],"summary":"List files","responses":{"200":{"description":"File records returned in the standard data/meta envelope."},"500":{"description":"Database query failed."}}},"post":{"tags":["Files"],"summary":"Upload and register a file","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["user_id","file_name","file"],"properties":{"us