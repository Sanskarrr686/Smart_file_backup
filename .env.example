# Team D Backend-for-Frontend Environment Configuration

# Server Port
PORT=4000

# API Versioning Prefix
API_VERSION=v1

# Security & Authentication Configuration
# MUST be changed to a strong, random secret in production deployments. NEVER commit production secrets!
JWT_SECRET=your_jwt_secret_here_change_in_production

# Allowed CORS Origins (comma-separated list for frontend dev & production servers)
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_MAX=100

# Upstream Team Execution Modes ('mock' or 'real')
# When set to 'mock', local simulation stores and logic are used when real services are unreachable.
TEAM_A_MODE=mock
TEAM_B_MODE=mock
TEAM_C_MODE=mock

# Upstream Team Base URLs (used only when respective mode is set to 'real')
TEAM_A_BASE_URL=http://localhost:5001
TEAM_B_BASE_URL=http://localhost:5002
TEAM_C_BASE_URL=http://192.168.10.202:3000

# Team D to Team C Shared Service Secret (for Bearer authentication header)
TEAM_C_SERVICE_SECRET=your_high_entropy_service_secret_here

# Team D to Team C Identity Mapping (JSON or key-value format mapping Team D string IDs to Team C numeric IDs)
TEAM_C_IDENTITY_MAP={"u_101":1,"u_102":2,"u_103":3}
# Optional Team C Location & Policy IDs for multipart uploads
TEAM_C_LOCATION_ID=
TEAM_C_POLICY_ID=

# Shared Storage Configuration (S3 / MinIO / Mock)
# Set STORAGE_MODE to 'minio' for real S3/MinIO storage, or 'mock' for local in-memory storage.
STORAGE_MODE=mock
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_minio_access_key
STORAGE_SECRET_KEY=your_minio_secret_key
STORAGE_BUCKET=backup-files
STORAGE_USE_SSL=false
STORAGE_MAX_SIZE_BYTES=104857600
