PORT=4000

TEAM_A_MODE=mock
TEAM_B_MODE=mock
TEAM_C_MODE=mock

TEAM_A_BASE_URL=http://localhost:5001
TEAM_B_BASE_URL=http://localhost:5002
TEAM_C_BASE_URL=http://localhost:5003

API_VERSION=v1

# Shared Storage Configuration (minio | mock)
STORAGE_MODE=mock
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_minio_access_key
STORAGE_SECRET_KEY=your_minio_secret_key
STORAGE_BUCKET=backup-files
STORAGE_USE_SSL=false
STORAGE_MAX_SIZE_BYTES=104857600
